<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Movies{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>🎬</text></svg>">
    {% block stylesheets %}{{ encore_entry_link_tags('app') }}{% endblock %}
    {% block javascripts %}{{ encore_entry_script_tags('app') }}{% endblock %}
</head>
<body class="grid grid-rows-[1fr_auto] min-h-screen">
{% block header %}
    <header>
        <nav class="flex items-center justify-between p-6 fixed w-full z-10 top-0 bg-gray-800">
            <a class="text-white no-underline text-2xl font-extrabold" href="{{ path('app_home_index') }}">Movies</a>

            <ul class="flex list-none items-center">
                <li><a class="text-gray-300 hover:text-white py-2 px-4" href="{{ path('app_home_index') }}">Home</a></li>
                <li><a class="text-gray-300 hover:text-white py-2 px-4" href="{{ path('movies') }}">Movies</a></li>
                <li>
                    <a class="text-gray-300 hover:text-white py-2 px-4" href="{{ path(app.user ? 'app_logout' : 'app_login') }}">
                        {{ app.user ? 'Logout' : 'Login' }}
                    </a>
                </li>
            </ul>
        </nav>
    </header>
{% endblock %}

{% for message in app.flashes('success') %}
    <div class="w-4/5 mx-auto mt-24 rounded bg-green-100 p-4 text-green-900" role="status">{{ message }}</div>
{% endfor %}

{% block body %}{% endblock %}

{% block footer %}
    <footer class="bg-gray-800 text-white text-center p-4 mt-5">
        <p class="w-4/5 text-center pb-3 m-auto text-base text-gray-100 pt-6">
            Movies portfolio project
        </p>
    </footer>
{% endblock %}
</body>
</html>
